# Chave da API do Resend. Não coloque a chave real neste arquivo.
RESEND_API_KEY=

# ID do Audience (lista) da newsletter na Resend.
# A Resend passou a chamar Audiences de Segments; use o ID dessa lista.
RESEND_AUDIENCE_ID=

# URL canônica usada em sitemap, Open Graph e JSON-LD.
# Opcional: na Vercel, se ficar vazio, o build usa VERCEL_PROJECT_PRODUCTION_URL.
# SITE_URL=https://guiaiabrasil.com.br
