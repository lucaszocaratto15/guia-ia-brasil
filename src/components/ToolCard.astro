---
import type { Tool } from '../data/tools';
import Badges from './Badges.astro';
import ToolMark from './ToolMark.astro';

interface Props {
  tool: Tool;
  level?: 'h2' | 'h3';
}

const { tool, level = 'h2' } = Astro.props;
const Title = level;
---

<article class="card">
  <div class="card-top">
    <ToolMark nome={tool.nome} dominio={tool.dominio} />
    <div class="card-id">
      <Title>
        <a href={`/ferramenta/${tool.slug}`}>{tool.nome}</a>
      </Title>
      <p class="card-meta">
        <a class="cat-link" href={`/categoria/${tool.categoriaSlug}`}>{tool.categoria}</a>
        <span class="dot" aria-hidden="true">·</span>
        <span class="domain">{tool.dominio}</span>
      </p>
    </div>
  </div>
  <p class="desc">{tool.descricao}</p>
  <Badges brasileira={tool.brasileira} portugues={tool.portugues} />
  <a class="visit" href={tool.urlFinal} target="_blank" rel="noopener noreferrer">
    Visitar site<span class="sr-only"> de {tool.nome} (abre em nova aba)</span>
  </a>
</article>
