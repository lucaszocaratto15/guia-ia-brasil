---
import { categories, recentTools, tools } from '../data/tools';
import SponsorCard from './SponsorCard.astro';
import ToolCard from './ToolCard.astro';
---

<section class="directory" id="diretorio" aria-labelledby="lista-titulo">
  <h2 id="lista-titulo" class="sr-only">Ferramentas</h2>
  <div class="filters">
    <div class="chips" role="group" aria-label="Filtrar por categoria">
      <button type="button" class="chip" data-chip data-category="" aria-pressed="true">Todas</button>
      {
        categories.map((category) => (
          <button type="button" class="chip" data-chip data-category={category.slug} aria-pressed="false">
            {category.nome}
          </button>
        ))
      }
    </div>
    <div class="toggles" role="group" aria-label="Filtrar por origem e idioma">
      <button type="button" class="chip" data-filter="brasil" aria-pressed="false">Feito no Brasil</button>
      <button type="button" class="chip" data-filter="portugues" aria-pressed="false">Em português</button>
    </div>
  </div>
  {
    recentTools.length > 0 && (
      <section id="novos" aria-labelledby="novos-titulo">
        <div class="section-head">
          <h2 id="novos-titulo">Novos lançamentos</h2>
          <p>As últimas entradas do guia.</p>
        </div>
        <ul class="rail">
          {recentTools.map((tool) => (
            <li>
              <ToolCard tool={tool} level="h3" />
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <div class="result-bar">
    <p id="contagem" aria-live="polite">{tools.length} ferramentas</p>
    <button type="button" id="limpar" class="ghost" hidden>Limpar filtros</button>
  </div>
  <ul class="grid" id="lista">
    <SponsorCard />
    {
      tools.map((tool) => (
        <li
          class="tool-item"
          data-category={tool.categoriaSlug}
          data-brasil={tool.brasileira ? '1' : '0'}
          data-portugues={tool.portugues ? '1' : '0'}
        >
          <ToolCard tool={tool} />
        </li>
      ))
    }
  </ul>
  <p id="vazio" class="empty" hidden>
    Nenhuma ferramenta com esses filtros. <a href="/sugerir">Sugira uma ferramenta</a> se ela ainda não está no guia.
  </p>
</section>
<script>
  import '../scripts/directory.ts';
</script>
