---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { faviconUrl, initials } from '../lib/format';

interface Props {
  nome: string;
  dominio: string;
}

const { nome, dominio } = Astro.props;
const src = faviconUrl(dominio);
const fileName = src.slice('/icons/'.length);
const hasIcon = existsSync(join(process.cwd(), 'public', 'icons', fileName));
---

<span class:list={['mark', { 'is-fallback': !hasIcon }]} data-initials={initials(nome)} aria-hidden="true">
  {
    hasIcon && (
      <img
        class="favicon"
        src={src}
        alt=""
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
      />
    )
  }
</span>
