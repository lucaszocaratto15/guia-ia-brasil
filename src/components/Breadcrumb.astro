---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Trilha">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span>{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>
